# AI Provider: "openai" (default) or "claude"
AI_PROVIDER=openai

# OpenAI (required when AI_PROVIDER=openai or unset)
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI Model (optional, defaults to gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude (required when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model (optional, defaults to claude-3-5-haiku-20241022)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Scryfall User Agent (optional, has default)
SCRYFALL_USER_AGENT=find-that-card/1.0 (+https://findthat.card)

# Search pipeline debug: set to true/1 to log query after each phase (original, Phase 0–3)
LOG_SEARCH_PIPELINE_DEBUG=true

# CardTrader Share Code (optional)
NEXT_PUBLIC_CARDTRADER_SHARE_CODE=your_share_code_here

# TCG Player Partner Link
TCG_PLAYER_PARTNER_LINK=https://partner.tcgplayer.com/your_code_here

# Resend API Key (required for bug report emails)
RESEND_API_KEY=re_your_api_key_here
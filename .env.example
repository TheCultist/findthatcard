# AI Provider: "openai" (default) or "claude"
AI_PROVIDER=openai

# OpenAI (required when AI_PROVIDER=openai or unset)
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI Model (optional, defaults to gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
# Reasoning effort for reasoning models (optional): low | medium | high
# OPENAI_REASONING_EFFORT=low

# Anthropic Claude (required when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model (optional, defaults to claude-haiku-4-5)
CLAUDE_MODEL=claude-haiku-4-5

# Scryfall User Agent (optional, has default)
SCRYFALL_USER_AGENT=find-that-card/1.0 (+https://findthatcard.net)

# Debug logging (optional): pipeline stages / full AI prompts
# LOG_SEARCH_PIPELINE_DEBUG=true
# LOG_AI_AGENT_PROMPT=true

# CardTrader Share Code (optional)
NEXT_PUBLIC_CARDTRADER_SHARE_CODE=your_share_code_here

# TCG Player Partner Link (optional)
TCG_PLAYER_PARTNER_LINK=https://partner.tcgplayer.com/your_code_here

# Resend API Key (required for bug report emails)
RESEND_API_KEY=re_your_api_key_here

# Cache directory (optional; defaults to ./data locally, /tmp on serverless)
# CACHE_DIR=
# CACHE_REFRESH=off   # serve cached/seed data without background refreshes (CI)
